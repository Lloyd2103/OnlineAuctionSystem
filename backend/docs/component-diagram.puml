@startuml
!theme plain

title "Online Auction System - Component Diagram"

package "Client Layer" {
    [Web Browser]
}

package "API Gateway" {
    [Routes\n(authRoute, auctionRoute,\nitemRoute, userRoute)]
}

package "Middleware" {
    [Auth Middleware]
}

package "Controller Layer" {
    [AuthController]
    [AuctionController]
    [BidController]
    [ItemController]
    [UserController]
    [TransactionController]
}

package "Manager Layer" {
    interface IAuctionManager
    interface IWalletManager
    [AuctionManager]
    [WalletManager]
}

package "Service Layer" {
    [AuctionService]
    [BidService]
    [ItemService]
    [UserService]
    [TransactionService]
}



package "Repository Layer" {
    [AuctionRepository]
    [BidRepository]
    [ItemRepository]
    [UserRepository]
    [TransactionRepository]
    [SessionRepository]
}

package "Model Layer" {
    [User]
    [Auction]
    [Bid]
    [Item]
    [Transaction]
    [Session]
}

database "Database" as DB {
    [MySQL\nServer]
}

' Relationships
[Web Browser] --> [Routes] : HTTP

[Routes] --> [Auth Middleware]
[Auth Middleware] --> [Controller Layer]

[Controller Layer] --> [IAuctionManager]
[Controller Layer] --> [IWalletManager]

[IAuctionManager] <-- [AuctionManager]
[IWalletManager] <-- [WalletManager]

[AuctionManager] --> [AuctionService]
[AuctionManager] --> [BidService]
[WalletManager] --> [TransactionService]
[WalletManager] --> [UserService]

[AuctionService] --> [AuctionState]
[AuctionService] --> [AuctionStateFactory]
[AuctionService] --> [BidValidationStrategy]

[Service Layer] --> [Repository Layer]
[Repository Layer] --> [Model Layer]
[Model Layer] --> DB : JDBC/ORM
@enduml